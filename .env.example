# 数据库连接串（本地 Docker PostgreSQL 示例）
DATABASE_URL="postgresql://myblog:myblog_dev_password@localhost:5432/myblog?schema=public"

# JWT 签名密钥，生产环境请替换为至少 32 位随机字符串
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# 初始化管理员的账号密码（仅 seed 时使用，生产环境请使用强密码）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# 站点正式访问地址，用于 metadata / sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
